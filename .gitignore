# Secrets — never commit the real .env (use .env.example as the template)
.env

# Local data: the SQLite DB and the downloaded airports CSV
data/*.db
data/*.db-journal
data/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
*.swp
data/*.db-wal
data/*.db-shm

# Tests
.pytest_cache/

# Tooling / scratch
.ruff_cache/
node_modules/
.mypy_cache/
.coverage
htmlcov/
scratch/
tmp/
*.tmp
# Screenshot temp files; committed screenshots (*.png) stay tracked
tests/e2e/**/screenshots/*.tmp.png
test-results/
playwright-report/
