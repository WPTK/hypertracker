# ----------------------------------------------------------------------------
# Hypertracker environment template. Copy to .env and edit. The real .env is
# gitignored. Only SECRET_KEY is required; AERODATABOX_KEY is needed for
# automatic flight resolution (manual airport entry works without it).
# ----------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
# REQUIRED. Signs session cookies and derives public owner ids. The app refuses
# to start if this is unset or a known placeholder (except DEV_MODE on localhost).
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Localhost only. Treats every visitor as a local admin; the app aborts at
# startup if DEV_MODE is on and BASE_URL is not localhost/127.0.0.1.
DEV_MODE=false

# true: anyone can view and add trips by typing a name. false: login required.
OPEN_BOARD=true

# Public base URL of the site (used for the OAuth redirect default).
BASE_URL=http://localhost:8000

# Sub-path when hosted under e.g. /board behind a reverse proxy. Empty at a root.
ROOT_PATH=

# Where client IPs come from, used for rate limits:
#   none        use the TCP peer (default; correct with no proxy)
#   cloudflare  trust CF-Connecting-IP, only when the peer is localhost
#   nginx       use the right-most untrusted X-Forwarded-For hop
# Set this to match your deployment, or every visitor shares one rate limit.
TRUSTED_PROXY=none

# Path to the SQLite file. Default: ./data/flightboard.db
# DB_PATH=

# --- Discord OAuth (optional; no bot needed) ---------------------------------
# Leave DISCORD_CLIENT_ID blank to hide the login button.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a redirect registered in the Discord developer portal exactly.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Optional: only members of this server may log in (adds the guilds scope).
DISCORD_GUILD_ID=
# Comma-separated Discord user ids that may edit or remove any trip.
ADMIN_DISCORD_IDS=

# --- AeroDataBox (flight and aircraft lookup) --------------------------------
AERODATABOX_KEY=
AERODATABOX_BASE=https://aerodatabox.p.rapidapi.com
AERODATABOX_HOST=aerodatabox.p.rapidapi.com
# Header scheme: rapidapi or apimarket
AERODATABOX_AUTH=rapidapi

# Cache lifetimes, seconds.
FLIGHT_CACHE_TTL=2592000       # legacy knob
FLIGHT_CACHE_TTL_PAST=2592000  # flights already flown (30 days)
FLIGHT_CACHE_TTL_NEAR=21600    # upcoming flights (6 hours)
FLIGHT_NEGATIVE_TTL=300        # "not found" answers (5 minutes)
AIRCRAFT_CACHE_TTL=7776000     # airframes (90 days)

# Accepted flight dates: today minus PAST days to today plus FUTURE days.
FLIGHT_WINDOW_PAST_DAYS=2
FLIGHT_WINDOW_FUTURE_DAYS=330

# Upstream timeouts, seconds. One call, and a whole multi-row resolve.
UPSTREAM_TIMEOUT=8
RESOLVE_DEADLINE=20
# Rows resolved in parallel.
RESOLVE_CONCURRENCY=3
# Budget of near-term re-resolves per day (fills in tail numbers close to departure).
MAX_REFRESH_PER_DAY=40

# --- airplanes.live (airborne / on ground status) ----------------------------
AIRPLANESLIVE_BASE=https://api.airplanes.live/v2

# --- Lifecycle ---------------------------------------------------------------
# Hours a trip stays on the board after its last leg ends.
TRIP_GRACE_HOURS=8
# Days after the last leg ends before a trip is deleted for good.
TRIP_PURGE_DAYS=3

# --- Write and preview limits (per client IP) --------------------------------
WRITE_RATE_LIMIT=12
WRITE_RATE_WINDOW=600
PREVIEW_RATE_LIMIT=60
PREVIEW_RATE_WINDOW=600
# Max legs per trip. Preview accepts up to twice this many rows.
MAX_LEGS_PER_TRIP=8

# --- Airport dataset ---------------------------------------------------------
AIRPORTS_CSV_URL=https://davidmegginson.github.io/ourairports-data/airports.csv
