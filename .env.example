# ----------------------------------------------------------------------------
# Hyperfixed Flight Tracker — environment template.
# Copy to .env and fill in. Everything has a sane default except AERODATABOX_KEY
# (needed only for automatic flight resolution; manual airport entry works
# without it). The real .env is gitignored.
# ----------------------------------------------------------------------------

# --- Session / app ---
# Used to sign session cookies. Generate one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# DEV_MODE=true bypasses login with a fake local ADMIN user so you can click
# around without any Discord setup. NEVER enable in production.
DEV_MODE=false

# OPEN_BOARD=true (default): anyone can view the board and add trips by typing a
# name — no login required; the browser remembers their trips for editing.
# OPEN_BOARD=false: Discord login is required to view and post.
OPEN_BOARD=true

# Public base URL of the site. Used to build the OAuth redirect default.
BASE_URL=http://localhost:8000

# Set to e.g. /board when hosting under a sub-path behind nginx/Cloudflare.
# Leave empty when serving at the root of a (sub)domain.
ROOT_PATH=

# --- Discord OAuth (OPTIONAL) ---
# Plain OAuth — no bot, and you do NOT need to own or moderate the server.
# Leave DISCORD_CLIENT_ID blank to hide the login button and run a name-only board.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a redirect URL registered under OAuth2 → Redirects, exactly.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Optional: if set, only members of THIS server may log in (read via the `guilds`
# scope — still no bot). The open board itself stays public unless OPEN_BOARD=false.
DISCORD_GUILD_ID=

# --- Admins (OPTIONAL) ---
# Comma-separated Discord user IDs allowed to edit/remove ANY trip (once logged in).
# Discord → Settings → Advanced → Developer Mode, then right-click your name → Copy User ID.
ADMIN_DISCORD_IDS=

# --- AeroDataBox (flight resolution + aircraft type/age) ---
# Defaults target RapidAPI. For API.Market or direct access, override BASE/HOST.
AERODATABOX_BASE=https://aerodatabox.p.rapidapi.com
AERODATABOX_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# Cache lifetimes in seconds (flights are immutable once flown; aircraft barely change).
FLIGHT_CACHE_TTL=2592000
AIRCRAFT_CACHE_TTL=7776000

# --- airplanes.live (live "is it airborne now?" check) ---
AIRPLANESLIVE_BASE=https://api.airplanes.live/v2

# --- Lifecycle ---
# Hours a trip lingers on the board after its final leg's scheduled arrival.
TRIP_GRACE_HOURS=8

# --- OurAirports dataset (used by scripts/update_airports.py) ---
AIRPORTS_CSV_URL=https://davidmegginson.github.io/ourairports-data/airports.csv

# --- Storage ---
# Override if you want the SQLite file somewhere specific.
# DB_PATH=/opt/hyperfixed-flight-tracker/data/flightboard.db

# --- Write protection ---
# Per-IP cap on write requests (create/edit/delete). Admins are exempt.
WRITE_RATE_LIMIT=12
WRITE_RATE_WINDOW=600
# Max legs in a single trip (also caps AeroDataBox spend per request).
MAX_LEGS_PER_TRIP=8

# --- Housekeeping ---
# Delete trips this many days after they leave the board (0 = keep forever).
TRIP_PURGE_DAYS=30
